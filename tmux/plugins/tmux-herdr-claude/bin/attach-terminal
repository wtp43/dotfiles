#!/usr/bin/env bash
# Attach a herdr terminal to this tmux pane. When another client takes it over
# (Heeler), wait here and reattach once that attach ends; any key takes it back.
# Exits on detach (ctrl+b q) or when the session is gone, unless bin/resume-hook
# pointed this terminal at another one, which it then attaches instead.
# Usage: attach-terminal <terminal_id> [--takeover]
. "$(dirname "$0")/../lib/herdr.sh"
terminal=$1 takeover=$2

follow_redirect() {
  local file=$redirects/$terminal next
  [ -f "$file" ] || return 0
  next=$(<"$file")
  rm -f "$file"
  exec "$0" "$next" --takeover
}

# herdr has no API for who holds an attach; Heeler's runs here as a process.
held_elsewhere() {
  pgrep -f "herdr (agent|terminal) attach ($terminal|$1)( |\$)" >/dev/null
}

while :; do
  "$herdr" terminal attach "$terminal" $takeover
  rc=$?
  follow_redirect
  [ $rc = 0 ] && exit 0
  pane=$(pane_of "$terminal")
  [ -n "$pane" ] || exit 0
  takeover=
  printf '\e[2J\e[H\e[?25l\n  \e[1mOpen on another device\e[0m\n  \e[2mReattaches here when it lets go  ·  any key takes it back\e[0m'
  while :; do
    if read -rsn1 -t 1; then takeover=--takeover; break; fi
    pane=$(pane_of "$terminal")
    [ -n "$pane" ] || { printf '\e[?25h\n'; follow_redirect; exit 0; }
    held_elsewhere "$pane" || break
  done
  printf '\e[?25h'
done
