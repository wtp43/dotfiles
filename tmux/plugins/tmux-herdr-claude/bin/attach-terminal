#!/usr/bin/env bash
# Attach a herdr terminal to this tmux pane. When another client takes it over
# (Heeler), wait here and reattach once that attach ends; any key takes it back.
# Exits on detach (ctrl+b q) or when the session is gone, unless bin/resume-hook
# pointed this terminal at another one, which it then attaches instead. When
# Claude Code exits, prints how to resume it (bin/end-hook saved the session).
# Usage: attach-terminal <terminal_id> [--takeover]
. "$(dirname "$0")/../lib/herdr.sh"
terminal=$1 takeover=$2
own_pane=$(pane_of "$terminal")

follow_redirect() {
  local file=$redirects/$terminal next
  [ -f "$file" ] || return 0
  next=$(<"$file")
  rm -f "$file"
  exec "$0" "$next" --takeover
}

# By name when the session has one (-n or /rename), else by id.
print_resume() {
  local file=$ended/$own_pane id transcript name arg
  [ -n "$own_pane" ] && [ -f "$file" ] || return 0
  id=$(jq -r .session_id "$file")
  transcript=$(jq -r .transcript_path "$file")
  rm -f "$file"
  name=$(grep -h '"type":"custom-title"' "$transcript" 2>/dev/null | tail -1 | jq -r '.customTitle // empty')
  arg=${name:-$id}
  [[ $arg =~ ^[[:alnum:]._/-]+$ ]] || arg="'${arg//\'/\'\\\'\'}'"
  printf '\nResume this session with:\nclaude --resume %s\n' "$arg"
}

# herdr has no API for who holds an attach; Heeler's runs here as a process.
held_elsewhere() {
  pgrep -f "herdr (agent|terminal) attach ($terminal|$1)( |\$)" >/dev/null
}

while :; do
  "$herdr" terminal attach "$terminal" $takeover
  rc=$?
  follow_redirect
  [ $rc = 0 ] && { print_resume; exit 0; }
  pane=$(pane_of "$terminal")
  [ -n "$pane" ] || { print_resume; exit 0; }
  takeover=
  printf '\e[2J\e[H\e[?25l\n  \e[1mOpen on another device\e[0m\n  \e[2mReattaches here when it lets go  ·  any key takes it back\e[0m'
  while :; do
    if read -rsn1 -t 1; then takeover=--takeover; break; fi
    pane=$(pane_of "$terminal")
    [ -n "$pane" ] || { printf '\e[?25h\n'; follow_redirect; print_resume; exit 0; }
    held_elsewhere "$pane" || break
  done
  printf '\e[?25h'
done
