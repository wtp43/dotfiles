#!/usr/bin/env bash
# Close the herdr pane behind a `herdr terminal attach`, ending its Claude Code
# session. Runs on the machine whose herdr hosts it (over ssh for dev).
# Usage: close-session --terminal <terminal_id>
#        close-session --ssh-client-port <port>   - the attach in that ssh session
. "$(dirname "$0")/../lib/herdr.sh"

case $1 in
  --terminal) terminal=$2 ;;
  --ssh-client-port)
    for pid in $(pgrep -f '[h]erdr terminal attach|[a]ttach-terminal '); do
      read -r _ port _ < <(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null | sed -n 's/^SSH_CONNECTION=//p')
      if [ "$port" = "$2" ] && [[ $(ps -o args= -p "$pid") =~ (terminal\ attach|attach-terminal)\ ([^ ]+) ]]; then
        terminal=${BASH_REMATCH[2]}
        break
      fi
    done ;;
  *) exit 2 ;;
esac
[ -n "$terminal" ] || exit 0

pane=$(pane_of "$terminal")
[ -n "$pane" ] && "$herdr" pane close "$pane" >/dev/null
exit 0
