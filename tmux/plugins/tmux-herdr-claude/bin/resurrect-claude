#!/usr/bin/env bash
# tmux-resurrect hooks. save: record the herdr Claude Code session each pane is
# attached to. restore: type `claude --resume <id>` at that pane's prompt, unrun.
# Usage: resurrect-claude save|restore
. "$(dirname "$0")/../lib/herdr.sh"
file=${XDG_DATA_HOME:-$HOME/.local/share}/tmux/resurrect/claude-sessions.tsv

case $1 in
save)
  snap=$(snapshot) || exit 0
  ps -ax -o ppid=,args= >"$file.ps"
  tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}	#{pane_pid}	#{pane_current_path}' |
    while IFS=$'\t' read -r target pid path; do
      term=$(awk -v p="$pid" '$1==p' "$file.ps" | grep -o 'attach-terminal term_[^ ]*' | head -1)
      [ -n "$term" ] || continue
      jq -r --arg t "${term#attach-terminal }" --arg target "$target" --arg path "$path" '
        .result.snapshot.panes[] | select(.terminal_id == $t and .agent_session.value != null)
        | [$target, .agent_session.value, .cwd, $path] | @tsv' <<<"$snap"
    done >"$file.tmp"
  rm -f "$file.ps"
  mv "$file.tmp" "$file"
  ;;
restore)
  [ -f "$file" ] || exit 0
  while IFS=$'\t' read -r target session cwd path; do
    cmd="claude --resume $session"
    [ "$cwd" = "$path" ] || cmd="cd $(printf %q "$cwd") && $cmd"
    # A restore inside a live server re-runs this hook: skip panes not at a zsh
    # prompt (an attached Claude shows as bash) and prompts that already hold it.
    [ "$(tmux display -p -t "$target" '#{pane_current_command}' 2>/dev/null)" = zsh ] || continue
    tmux capture-pane -p -t "$target" | grep -Fq -- "$cmd" && continue
    tmux send-keys -t "$target" -l "$cmd"
  done <"$file"
  ;;
esac
