#!/usr/bin/env python3
"""Start Claude Code in a background herdr tab and attach it to this terminal.

The tab joins the herdr workspace that already has a pane in this git repo (or
directory), else a new workspace named after it; neither takes focus. Talks to
the herdr socket directly, one request per connection, so setup takes a few ms.
Without a running herdr server it posts a notification and exits 75, and the
shell function runs claude directly.
"""
import json
import os
import shlex
import shutil
import socket
import subprocess
import sys
import time

SOCKET = os.environ.get("HERDR_SOCKET_PATH") or os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "herdr", "herdr.sock"
)
# Followed over ssh by the Mac's herdr agent-notify listener.
REMOTE_LOG = os.path.expanduser("~/.local/state/herdr/plugins/wt.agent-notify/events.log")
NOT_IN_HERDR = 75


def call(method, params):
    with socket.socket(socket.AF_UNIX) as sock:
        sock.settimeout(5)
        sock.connect(SOCKET)
        stream = sock.makefile("rwb")
        stream.write((json.dumps({"id": f"herdr-claude:{method}", "method": method, "params": params}) + "\n").encode())
        stream.flush()
        response = json.loads(stream.readline())
    if "result" not in response:
        raise RuntimeError(f"{method}: {response.get('error')}")
    return response["result"]


def project_root(cwd):
    try:
        out = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel"],
                             capture_output=True, text=True, timeout=2)
    except (OSError, subprocess.TimeoutExpired):
        return cwd
    return os.path.realpath(out.stdout.strip()) if out.returncode == 0 else cwd


def inside(path, root):
    if not path:
        return False
    path = os.path.realpath(path)
    return path == root or path.startswith(root.rstrip("/") + "/")


def notify_not_in_herdr(cwd):
    title = "Claude Code is not in herdr"
    body = f"herdr isn't running, so the session in {os.path.basename(cwd) or cwd} runs directly in tmux; Heeler can't see it."
    if sys.platform == "darwin":
        if shutil.which("terminal-notifier"):
            command = ["terminal-notifier", "-title", title, "-message", body, "-sound", "default"]
        else:
            command = ["osascript", "-e", "on run argv",
                       "-e", 'display notification (item 2 of argv) with title (item 1 of argv) sound name "Glass"',
                       "-e", "end run", title, body]
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return
    try:
        os.makedirs(os.path.dirname(REMOTE_LOG), exist_ok=True)
        with open(REMOTE_LOG, "a") as log:
            log.write(json.dumps({"notice": {"title": title, "body": body}, "time": int(time.time())}) + "\n")
    except OSError:
        pass


def main():
    args = sys.argv[1:]
    cwd = os.path.realpath(os.getcwd())
    try:
        snapshot = call("session.snapshot", {})["snapshot"]
    except (OSError, RuntimeError, ValueError):
        notify_not_in_herdr(cwd)
        sys.exit(NOT_IN_HERDR)

    root = project_root(cwd)
    workspace = next((p["workspace_id"] for p in snapshot["panes"] if inside(p.get("cwd"), root)), None)
    # The tab's shell execs Claude Code before its first prompt (see
    # shell/herdr-claude.zsh), so nothing is typed into it; when Claude Code
    # exits the pane closes, which ends the attach below.
    env = {"HERDR_CLAUDE_EXEC": "1", "HERDR_CLAUDE_ARGS": shlex.join(args)}
    # Over ssh, copies must reach the ssh client's clipboard. Claude Code's own
    # OSC 52 (what it sends when it sees SSH_* variables) is kept by herdr for
    # full herdr windows, so the tab gets shim/wl-copy instead.
    if "SSH_CONNECTION" in os.environ:
        env["HERDR_CLAUDE_REMOTE_CLIPBOARD"] = "1"
    if workspace:
        created = call("tab.create", {"workspace_id": workspace, "cwd": cwd, "focus": False, "env": env})
    else:
        created = call("workspace.create", {"cwd": cwd, "label": os.path.basename(root), "focus": False, "env": env})
    os.execvp("herdr", ["herdr", "terminal", "attach", created["root_pane"]["terminal_id"]])


if __name__ == "__main__":
    main()
