#!/usr/bin/env bash
# Stand-in wl-copy for Claude Code started by herdr-claude over ssh (see
# shell/herdr-claude.zsh): the copy reaches the ssh client's terminal as OSC 52.
# herdr forwards a pane's own OSC 52 only to a full herdr window, never to a
# `herdr terminal attach`, so this writes it to the attach's terminal directly.
for arg; do
  case $arg in -p|--primary) cat >/dev/null; exit 0 ;; esac
done
. "$(dirname "$0")/../lib/herdr.sh"
seq=$(printf '\033]52;c;%s\a' "$(base64 -w0)")

sent=
term=$(terminal_of "${HERDR_PANE_ID:-}")
if [ -n "$term" ]; then
  for pid in $(pgrep -u "$(id -u)" -f "terminal attach $term"); do
    tty=$(readlink "/proc/$pid/fd/1")
    [[ $tty == /dev/pts/* && -w $tty ]] && printf '%s' "$seq" >"$tty" && sent=1
  done
fi
# Not attached (viewed in a herdr window): herdr forwards this one there.
[ -n "$sent" ] || printf '%s' "$seq" >/dev/tty
