# set -g default-terminal "tmux-256color"
set -sa terminal-overrides ',xterm-256:RGB,*:Se=\033[6 q'
# set -ga terminal-overrides ',tmux-256color:Tc,*:Se=\033[6 q'
set -ga terminal-overrides ",xterm-256color:Tc"
set -g prefix C-a
unbind C-b
bind-key C-a send-prefix

# unbind %
# bind | split-window -h 
#
# unbind '"'
# bind - split-window -v

# Shift arrow to switch windows
bind -n C-Left  previous-window
bind -n C-Right next-window

unbind r
bind r source-file ~/.tmux.conf

# Resize panes (repeatable) with prefix + arrow keys
bind -r Left  resize-pane -L 5
bind -r Down  resize-pane -D 5
bind -r Up    resize-pane -U 5
bind -r Right resize-pane -R 5
unbind s
# Vim style pane selection
# bind h select-pane -L
# bind j select-pane -D 
# bind k select-pane -U
# bind l select-pane -R

# Start windows and panes at 1, not 0
set -g base-index 1
set -g pane-base-index 1
set-window-option -g pane-base-index 1
set-option -g renumber-windows on
set -g mouse on

set-window-option -g mode-keys vi

bind-key -T copy-mode-vi 'v' send -X begin-selection # start selecting text with "v"
bind-key -T copy-mode-vi 'y' send -X copy-selection-and-cancel # copy text with "y"

# unbind -T copy-mode-vi MouseDragEnd1Pane # don't exit copy mode when dragging with mouse

# remove delay for exiting insert mode with ESC in Neovim
set -sg escape-time 10

# tpm plugin
set -g @plugin 'tmux-plugins/tpm'

# list of tmux plugins
set -g @plugin 'christoomey/vim-tmux-navigator'
# set -g @plugin 'jimeh/tmux-themepack'
set -g @plugin 'tmux-plugins/tmux-resurrect' # persist tmux sessions after computer restart
set -g @plugin 'tmux-plugins/tmux-continuum' # automatically saves sessions for you every 15 minutes
set -g @plugin 'tmux-plugins/tmux-yank'
set -g @plugin 'thewtex/tmux-mem-cpu-load'

# set -g @themepack 'powerline/default/cyan'

# set -g @resurrect-capture-pane-contents 'on'
set -g @continuum-restore 'on'
set -g @continuum-save-interval '5'
set-hook -g client-detached 'run-shell -b "~/.tmux/plugins/tmux-resurrect/scripts/save.sh quiet"'
bind Q run-shell '~/.tmux/plugins/tmux-resurrect/scripts/save.sh quiet' \; kill-server
# Split panes vim-style, keeping cwd (-b = new pane before: left/above)
bind h split-window -hb -c "#{pane_current_path}"   # left
bind j split-window -v  -c "#{pane_current_path}"   # below
bind k split-window -vb -c "#{pane_current_path}"   # above
bind l split-window -h  -c "#{pane_current_path}"   # right
# tpm defaults to ~/.config/tmux/plugins when this file lives there; the plugins are in ~/.tmux/plugins.
set-environment -g TMUX_PLUGIN_MANAGER_PATH '~/.tmux/plugins/'
set -g status-interval 3
set -g status-left-length 200
set -g status-left ' #[fg=#f5a800]#[default] #[fg=green]#{session_name}#[default] 󰒋 #[fg=green]#h#[default] %-I:%M %p ∣ #(~/.config/tmux/mem-cpu.sh 3) ∣ #[fg=green]#{pane_title}#[default] '
set -g status-right-length 150
set -g status-format[0] '#[align=left range=left #{E:status-left-style}]#[push-default]#{T;=/#{status-left-length}:status-left}#[pop-default]#[norange default]#[nolist align=right range=right #{E:status-right-style}]#[push-default]#{T;=/#{status-right-length}:status-right}#[pop-default]#[norange default]'
set -g @pane_label '#{?#{m/r:^[0-9]+[.][0-9]+[.][0-9]+$,#{pane_current_command}},claude,#{pane_current_command}}'
set -g automatic-rename-format '#{E:@pane_label}'
set -g pane-border-lines heavy
set -g pane-border-indicators off
set -g pane-border-style 'fg=#5a5a5a'
set -g pane-active-border-style '#{?pane_in_mode,fg=yellow,#{?synchronize-panes,fg=red,fg=#5a5a5a}}'
set -g pane-border-status bottom
set -g pane-border-format '#{?pane_active,#[fg=#0a84ff]#{R:━,#{e|-:#{pane_width},#{?pane_at_right,4,3}}}#[default],}'
# Must stay before tpm: tmux-continuum prepends its autosave hook to status-right at load.
set -g status-right '#{?window_bigger,[#{window_offset_x}#,#{window_offset_y}] ,}%b %d '
# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'

# Known issue: focus-in (ESC[I) sequences cancel Claude Code's /ide and /mcp
# pickers the instant the pane gains focus. See anthropics/claude-code#10375.
set-option -g focus-events on

# Claude Code recommended terminal settings
set -g allow-passthrough on
set -s extended-keys on
set -as terminal-features 'xterm*:extkeys'

set -s set-clipboard on

set -g set-titles on
set -g set-titles-string '#T'

set -g status-style 'bg=#3a3a3a,fg=#ffffff,bold'
set -g message-style 'bg=#3a3a3a,fg=#ffffff'
set -g mode-style 'bg=#0a84ff,fg=#ffffff'



# bind -n C-k run-shell    '#{d:config_files}/bin/tmux-vim-select-pane -U'
# bind -n C-j run-shell    '#{d:config_files}/bin/tmux-vim-select-pane -D'
# bind -n C-h run-shell    '#{d:config_files}/bin/tmux-vim-select-pane -L'
# bind -n C-l run-shell    '#{d:config_files}/bin/tmux-vim-select-pane -R'
# bind -n "C-\\" run-shell '#{d:config_files}/bin/tmux-vim-select-pane -l'
# From an ssh pane, the new pane runs the same ssh command (see ~/.config/tmux/split-same.sh).
bind h run-shell '~/.config/tmux/split-same.sh #{pane_id} #{pane_pid} "#{pane_current_path}" "#{pane_path}" -hb'
bind j run-shell '~/.config/tmux/split-same.sh #{pane_id} #{pane_pid} "#{pane_current_path}" "#{pane_path}" -v'
bind k run-shell '~/.config/tmux/split-same.sh #{pane_id} #{pane_pid} "#{pane_current_path}" "#{pane_path}" -vb'
bind l run-shell '~/.config/tmux/split-same.sh #{pane_id} #{pane_pid} "#{pane_current_path}" "#{pane_path}" -h'
