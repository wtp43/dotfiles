theme = my-theme
#font-family = SF Mono

# config in ghostty
font-size=13
font-family=FiraCode Nerd Font Mono
# adjust-cell-width = "-2%"
adjust-cell-height = 10%
adjust-cursor-height = -25%


auto-update-channel = tip
macos-titlebar-proxy-icon=hidden
mouse-hide-while-typing=true
clipboard-read=allow
clipboard-write=allow
copy-on-select=clipboard
unfocused-split-opacity=1
mouse-scroll-multiplier=0.25
# zshrc sets the vi-mode cursor; Ghostty's own can only blink both shapes or neither.
shell-integration-features = no-cursor

# keybinds
# keybind = ctrl+cmd+o=next_tab
keybind = ctrl+cmd+r=reload_config

# split actions
# keybind = ctrl+a>j=new_split:down
# keybind = ctrl+a>k=new_split:up
# keybind = ctrl+a>l=new_split:right
# keybind = ctrl+a>h=new_split:left
# keybind = ctrl+j=goto_split:down
# keybind = ctrl+k=goto_split:up
# keybind = ctrl+l=goto_split:right
# keybind = ctrl+h=goto_split:left

keybind = ctrl+a>i=increase_font_size:1
keybind = ctrl+a>u=decrease_font_size:1

keybind = ctrl+a>t=toggle_quick_terminal




