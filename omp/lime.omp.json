{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "lime": "#dfff47",
    "yellow": "#ffe83f",
    "gray": "#969696",
    "sep": "#7c7c7d",
    "slate": "#676c84",
    "red": "#ff6b6b"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "root",
          "style": "plain",
          "foreground": "p:red",
          "template": " "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:lime",
          "options": {
            "fetch_status": true,
            "branch_icon": ""
          },
          "template": "{{ .HEAD }}<p:gray>{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }}</>{{ if .Staging.Changed }}<p:lime> +{{ .Staging.String }}</>{{ end }}{{ if .Working.Changed }}<p:yellow> {{ .Working.String }}</>{{ end }}{{ if gt .StashCount 0 }}<p:gray> ⚑{{ .StashCount }}</>{{ end }}<p:sep> | </>"
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:gray",
          "options": {
            "style": "full"
          },
          "template": "{{ .Path }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:slate",
          "template": "{{ trunc 7 .Commit.Sha }} {{ trunc 60 .Commit.Subject }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:yellow",
          "foreground_templates": ["{{ if gt .Code 0 }}p:red{{ end }}"],
          "template": "▶▶"
        }
      ]
    }
  ]
}
