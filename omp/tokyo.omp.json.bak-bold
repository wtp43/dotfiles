{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "palette": {
    "os": "#7c808e",
    "path": "#34353e",
    "git": "#34353e",
    "ink": "#1a1b20",
    "green": "#c3ff00",
    "red": "#d9527f",
    "gold": "#fdc221",
    "cyan": "#00d9c3",
    "lavender": "#a6b0d8",
    "pink": "#f4b8e4",
    "blue": "#87cefa",
    "bolt": "#f5a800"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "p:os",
          "foreground_templates": [
            "{{ if .Root }}p:red{{ end }}"
          ],
          "template": " <p:bolt></> {{ .HostName }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "p:blue",
          "options": {
            "style": "full"
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "p:blue",
          "options": {
            "fetch_status": true,
            "branch_icon": " "
          },
          "template": " [{{ .HEAD }}{{ if gt .Ahead 0 }}<p:lavender> ↑{{ .Ahead }}</>{{ end }}{{ if gt .Behind 0 }}<p:lavender> ↓{{ .Behind }}</>{{ end }}{{ if .Staging.Changed }}<p:cyan>  {{ .Staging.String }}</>{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }}<p:lavender> |</>{{ end }}{{ if .Working.Changed }}<p:gold>  {{ .Working.String }}</>{{ end }}{{ if gt .StashCount 0 }}<p:pink>  {{ .StashCount }}</>{{ end }}] "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "template": " "
        }
      ]
    }
  ]
}
